	{ "axr_task_manager",      "on_task_callback" },
	-- v3: the LEAVES of se_smart_terrain:update(). On the eng axis rather than
	-- on `sub` precisely so they are a different axis from their callers and
	-- therefore get timed instead of being counted as nested.
	{ "smart_terrain",         "arrived_to_smart" },
