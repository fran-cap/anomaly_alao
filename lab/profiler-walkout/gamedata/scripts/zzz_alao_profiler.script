	{ "bind_smart_terrain",    "smart_terrain_binder"    },
	{ "bind_smart_cover",      "smart_cover_binder"      },
	{ "bind_camp",             "camp_binder"             },
	{ "bind_crow",             "crow_binder"             },
	{ "bind_car",              "car_binder"              },
	{ "bind_heli",             "heli_binder"             },
	{ "bind_dynamic_light",    "generic_light_binder"    },
	{ "bind_signal_light",     "signal_light_binder"     },
