-- Methods the engine calls on those classes directly. `update` is separated
-- out because it is the only per-frame one and therefore the only one with a
-- steady-state price.
local BINDER_METHODS = {
	"net_spawn", "net_destroy", "reinit", "load", "save",
	"net_save", "net_import", "net_export", "net_Relcase",
	"on_register", "on_unregister", "switch_online", "switch_offline",
	"can_switch_online", "can_switch_offline", "STATE_Write", "STATE_Read",
	"shedule_update",
}
local BINDER_UPDATE_METHODS = { "update" }

-- Engine-called globals. {module, function}; module "" means a bare global
-- (everything _g.script defines lands in _G, which is why ProcessEventQueue
-- and CreateTimeEvent are addressed with no module).
local GLOBAL_TARGETS = {
	{ "visual_memory_manager", "get_visible_value" },
	{ "",                      "ProcessEventQueue" },
	{ "xr_logic",              "issue_event" },
	{ "xr_logic",              "try_switch_to_another_section" },
	{ "game_relations",        "get_npcs_relation" },
	{ "xr_logic",              "pstor_retrieve" },
	{ "xr_logic",              "pstor_store" },
